# =============================================================================
# JARVIS — Environment Configuration
# Copy this file to .env and fill in the values you need.
# =============================================================================

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local mode (default): SQLite, no setup required.
USE_SQLITE=true
SQLITE_PATH=./data/jarvis.db
# Production mode: set USE_SQLITE=false and provide a Postgres URL.
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis

# --- AI Provider ---
# One of: local | openai | anthropic
# "local" is the default: a free, self-hosted OpenAI-compatible endpoint
# (Ollama, LM Studio, vLLM, llama.cpp server, ...). No API key, no cost.
# Install Ollama (https://ollama.com), run `ollama pull llama3.1`, then
# `ollama serve` (default port 11434) and JARVIS will use it automatically.
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_SUPPORTS_TOOL_CALLS=false

# Optional bring-your-own-key providers — only used if you set AI_PROVIDER
# to "openai" or "anthropic". Leave blank to stay 100% free/local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings (memory) ---
# One of: openai | local
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma

# --- Voice ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-GuyNeural
WAKE_WORD=jarvis

# --- Automation / Security ---
# Master switch for any action that controls the OS (mouse, keyboard, apps, files).
AUTOMATION_ENABLED=false
# Actions that always require an explicit confirmation step, regardless of the
# switch above: delete_file, send_email, execute_terminal_command, browser_login
REQUIRE_CONFIRMATION_FOR=delete_file,send_email,execute_terminal_command,browser_login

# --- Vision ---
FACE_RECOGNITION_CONSENT=false
OCR_LANGUAGE=eng

# --- Email (per-user credentials are stored encrypted; these are defaults only) ---
DEFAULT_IMAP_HOST=imap.gmail.com
DEFAULT_IMAP_PORT=993
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
